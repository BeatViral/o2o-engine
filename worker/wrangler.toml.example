name = "o2o-engine-api"
main = "src/worker.js"
compatibility_date = "2026-05-22"

# Optional: use workers.dev for quick testing.
# route = "api.yourdomain.com/*"

[vars]
ALLOWED_ORIGIN = "*"
OPENAI_MODEL = "gpt-4.1-mini"
ANTHROPIC_MODEL = "claude-3-5-sonnet-latest"
RATE_LIMIT_PER_MINUTE = "20"
BILLING_ENFORCED = "false"
LEMON_VARIANT_PLAN_MAP = "12345:starter,23456:pro,34567:scale"
CHECKOUT_URL_STARTER = ""
CHECKOUT_URL_PRO = ""
CHECKOUT_URL_SCALE = ""
PDF_EXPORT_SERVICE_URL = ""

# Optional KV for per-IP rate limiting.
# [[kv_namespaces]]
# binding = "RATE_LIMIT_KV"
# id = "REPLACE_WITH_KV_NAMESPACE_ID"

# Required KV for subscribers and usage metering.
# [[kv_namespaces]]
# binding = "SUBSCRIBER_KV"
# id = "REPLACE_WITH_SUBSCRIBER_KV_NAMESPACE_ID"

# Recommended KV for system memory persistence.
# If omitted, Worker falls back to SUBSCRIBER_KV for memory storage.
# [[kv_namespaces]]
# binding = "SYSTEM_MEMORY_KV"
# id = "REPLACE_WITH_SYSTEM_MEMORY_KV_NAMESPACE_ID"

# Required secrets (set with Wrangler):
# wrangler secret put OPENAI_API_KEY
# wrangler secret put ANTHROPIC_API_KEY   # required for mode="deep"
# wrangler secret put SESSION_SIGNING_SECRET
# Optional for webhook verification:
# wrangler secret put LEMON_WEBHOOK_SECRET
